# Public site / stratum host (no Umbrel)
DOMAIN=lido.wtf
PUBLIC_POOL_STRATUM_URL=st.lido.wtf:3333

# Host ports
HTTP_PORT=80
STRATUM_V1_HOST_PORT=3333
STRATUM_V2_HOST_PORT=4444
# Expose pool HTTP API for local lido-ui (`npm run dev` → PUBLIC_POOL_API_URL)
API_HOST_PORT=2299

# Bitcoin Core RPC (required — synced node; may be a separate host)
BITCOIN_RPC_URL=http://127.0.0.1
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_USER=bitcoin
BITCOIN_RPC_PASSWORD=changeme
BITCOIN_RPC_TIMEOUT=10000
# Optional ZMQ for faster block tips, e.g. tcp://10.69.4.20:28332
# BITCOIN_ZMQ_HOST=

# Image tags (own GHCR packages — never lido / lido-ui)
LIDO_PUBLIC_TAG=0.1.2
LIDO_PUBLIC_UI_TAG=0.1.2

# Pool identity
POOL_IDENTIFIER=Lido
NETWORK=mainnet

# Optional Discord / Telegram (same env names as the pool image)
# DISCORD_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
